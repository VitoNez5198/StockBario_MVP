# ============================================================
# StockBarrio MVP — Variables de Entorno
# Copia este archivo como .env para desarrollo local.
# En producción (Render / Railway), configúralas en el panel.
# ============================================================

APP_NAME="StockBarrio"
APP_ENV="development"
DEBUG=true

# Seguridad (cambiar en producción por una clave aleatoria larga)
SECRET_KEY="cambia-esta-clave-en-produccion-por-una-segura"
SESSION_EXPIRE_HOURS=12

# Base de Datos
# En producción usar PostgreSQL (Render / Railway / Neon / Supabase):
# DATABASE_URL="postgresql+psycopg://usuario:password@host:5432/stockbarrio"
# En desarrollo local puedes usar SQLite sin instalar PostgreSQL:
DATABASE_URL="sqlite:///./stockbarrio_dev.db"

# Datos del almacén por defecto (onboarding inicial)
DEFAULT_STORE_NAME="Almacén de Barrio"
DEFAULT_ADMIN_USER="admin"
DEFAULT_ADMIN_PIN="1234"
