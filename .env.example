# Configuracion local de StockBarrio
# Copiar como .env para trabajar en local

APP_NAME="StockBarrio"
APP_ENV="development"
DEBUG=true

SECRET_KEY="cambiar-por-clave-segura"
SESSION_EXPIRE_HOURS=12

# Produccion: postgresql+psycopg://usuario:clave@host:5432/stockbarrio
DATABASE_URL="sqlite:///./stockbarrio_dev.db"

DEFAULT_STORE_NAME="Almacen de Barrio"
DEFAULT_ADMIN_USER="admin"
DEFAULT_ADMIN_PIN="1234"
